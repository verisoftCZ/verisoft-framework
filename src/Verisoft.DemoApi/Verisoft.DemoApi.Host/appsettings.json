{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "HangfireDashboardConfig": {
    "AppPath": "",
    "PrefixPath": "",
    "AuthorizationEnabled": true
  },
  "HangfireJobs": {
    "JobOneSettings": "0 0 * * *",
    "JobTwoSettings": "0 1 * * *"
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": "https://verisoft-internal-vault.vault.azure.net/"
  },
  "AzureBlobStorage": {
    "AzureBlobContainerName": "azure-webjobs-hosts"
  },
  "ApplicationInsights": {
    "Enabled": false,
    "InstrumentationKey": "guid-key",
    "DefaultProperties": {
      "Country": "CZ",
      "Component": "VerisoftDemoApi"
    },
    "RunLocation": "Czechia",
    "AvailabilityTestName": "selftest",
    "AvailabilityEveryMinutes": 5
  },
  "MassTransit": {
    "Server": {
      "Url": "rabbitmq://localhost", // docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:management
      "UserName": "guest",
      "Password": "guest",
      "UseSsl": false
    }
  }
}